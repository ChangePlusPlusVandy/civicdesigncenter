# Copy to .env (gitignored). Every value is optional for local development.
# Real values live in GitHub Actions, Vercel and the server's environment, never here.

# --- Server ---
PORT=3000

# Leave blank to use PGlite: an embedded Postgres stored in ./.pglite, no install needed.
# Set a Postgres URL to use something else: Neon for demos (ask the EM), or the optional Docker database
# (docker compose up -d db):
#   DATABASE_URL=postgres://citysettlers:citysettlers@localhost:5432/citysettlers
DATABASE_URL=

# Direct (non-pooled) connection for migrations on Neon. Defaults to DATABASE_URL.
DATABASE_URL_DIRECT=

# Extra browser origins allowed by CORS, comma-separated (Vercel previews). Not needed locally.
CORS_ORIGINS=

# Signs sessions. Any string locally; a long random value in deployed environments.
SESSION_SECRET=dev-only-change-me

# --- Web (VITE_ values are bundled into the browser: never put secrets here) ---
# API origin for the web client. Leave blank locally (Vite proxies to the server)
# and when the server serves the client (same origin). Vercel previews may set it to a demo server.
VITE_API_URL=
