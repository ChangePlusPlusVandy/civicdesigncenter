# nginx server block for compose.nginx.yml. Copy to
# /etc/nginx/sites-available/citysettlers, set server_name and the port
# (HOST_PORT), link it into sites-enabled, then `nginx -t && systemctl reload nginx`.
# HTTPS: `certbot --nginx -d <subdomain>` (only with the host owner's OK).
server {
    listen 80;
    server_name citysettlers.example.org;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        # WebSockets (Socket.IO)
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 1h;
    }
}
